# StockLens AI — environment variables (PLACEHOLDERS ONLY)
#
# Copy this file to .env.local for local development:   cp .env.example .env.local
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Never commit .env.local and never prefix any of these with NEXT_PUBLIC_.

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
# Check the model IDs available to your key in Google AI Studio before setting these.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# --- Market data ---
# https://finnhub.io/register  (quotes, ticker search, company news)
FINNHUB_API_KEY=your-finnhub-api-key
# https://www.tiingo.com/account/api/token  (90-day daily price history)
TIINGO_API_KEY=your-tiingo-api-key
# Optional fallback: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# --- Upstash Redis (https://console.upstash.com → your database → REST API) ---
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Authentication ---
# Generate with:  openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
# Password for /debug (at least 12 characters)
DEBUG_PASSWORD=replace-with-a-debug-password
# "password" = whole app behind DEMO_PASSWORD (default, required by data licensing)
DEMO_MODE=password
# Password for the app itself. Must be different from DEBUG_PASSWORD.
DEMO_PASSWORD=replace-with-a-different-demo-password

# --- Usage limits (optional; defaults shown) ---
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=50
GLOBAL_DAILY_CAP=40
